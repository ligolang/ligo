build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://gitlab.com/ligolang/ligo.git"
pin-depends: [
  [
  "grace.0.2.0"
  "git+https://github.com/johnyob/grace.git#d15a6d7d07a2551d1a9934fa79c2cf84c918f990"
]
  [
  "ocaml-recovery-parser.0.3.0"
  "git+https://github.com/serokell/ocaml-recovery-parser.git#b8207b0c919b84d5096486e59985d0137c0c4d82"
]
]