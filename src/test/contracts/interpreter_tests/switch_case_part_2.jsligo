// 3 case 1 default - 3 * 3 * 3 * 2 -> 54 cases

const case1 = (n : int) : string => {
  let output = "";
  switch (n) {
    case 1: output = output + "Hello";
    case 2: output = output + " World";
    case 3: output = output + " @@@";
    default: output = output + " !!!";
  };
  output = output + " end";
  return output;
};

const _test1 = () : unit => {
  const _1 = case1(1);
  const _2 = case1(2);
  const _3 = case1(3);
  const _4 = case1(4);
  Assert.assert (_1 == "Hello World @@@ !!! end");
  Assert.assert (_2 == " World @@@ !!! end");
  Assert.assert (_3 == " @@@ !!! end");
  Assert.assert (_4 == " !!! end");
};

const test1 = _test1();

const case2 = (n : int) : string => {
  let output = "";
