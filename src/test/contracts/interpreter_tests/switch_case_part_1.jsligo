// 2 case 1 default - 3 * 3 * 2 -> 18 cases

const case1 = (n : int) : string => {
  let output = "";
  switch (n) {
    case 1: output = output + "Hello";
    case 2: output = output + " World";
    default: output = output + " !!!";
  }
  return output;
};

const _test1 = () : unit => {
  const _1 = case1(1);
  const _2 = case1(2);
  const _3 = case1(3);
  Assert.assert (_1 == "Hello World !!!" &&
                 _2 == " World !!!" &&
                 _3 == " !!!");
};

const test1 = _test1();

const case2 = (n : int) : string => {
  let output = "";
  switch (n) {
    case 1: output = output + "Hello";
    case 2: output = output + " World";
            break;
    default: output = output + " !!!";
  }
  return output;
};

const _test2 = () : unit => {
  const _1 = case2(1);
  const _2 = case2(2);
  const _3 = case2(3);
  Assert.assert (_1 == "Hello World" &&
                 _2 == " World" &&
                 _3 == " !!!");
};

const test2 = _test2();

