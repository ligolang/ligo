type parameter =
| ["Increment", int]
| ["Decrement", int];

type storage = int;

type return_ = [list<operation>, storage];

const main = (action : parameter, store: storage) : return_ => {
  const storage =
    $match (action, {
      "Increment": (n) => store + n,
      "Decrement": (n) => store - n
    });
  return [[], storage];
};
