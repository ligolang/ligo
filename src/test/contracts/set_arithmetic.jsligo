/* Test set operations in JsLIGO */

const literal_op = (_: unit) : set <string> =>
  Set.literal (["foo", "bar", "foobar"]);

const size_op = (s: set <string>): nat =>
  Set.cardinal (s);

const add_op = (s: set <string>) : set <string> =>
  Set.add ("foobar", s);

const remove_op = (s: set <string>) : set <string> =>
  Set.remove ("foobar", s);

const remove_deep = (s: [set <string>, nat]): [set <string>, nat] =>
  [Set.remove ("foobar", s[0]), s[1]];

const patch_op = (s: set <string>) : set <string> =>
  Set.add ("foobar", s);

const patch_op_deep = (s: [set <string>, nat]) : [set <string>, nat] =>
  [Set.add ("foobar", s[0]), s[1]];

const mem_op = (s: set <string>) : bool => Set.mem ("foobar", s);

const iter_op = (s : set <int>) : int => {
  Set.iter (((_ : int) => unit), s);
  return 0;
}

const aggregate = ( [i,j] : [list <int>, int]) : list <int> => list ([j, ...i]);

const fold_op  = (s : set <int>) : list<int> => Set.fold (aggregate, s, [])

const aggregate2 = ( [i,j] : [int , list<int>]) : list<int> => list ([i, ...j]);
const fold_right = (s : set <int>) : list<int> => Set.fold_desc (aggregate2, s, []);

const filter_map_lit =
  Set.filter_map((s : string) => {
    if (String.length(s) > (3 as nat)) {
      return ["Some" as "Some", String.length(s)];
    };
    return ["None" as "None"];
  }, literal_op());
