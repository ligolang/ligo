type foobar = option <int>;

const s : foobar = ["Some" as "Some", 42];
const n : foobar = ["None" as "None"];
const i : int    = Option.value_with_error("won't happen", s);

const assign = (m : int) : foobar => {
  let coco : foobar = ["None" as "None"];
  coco = ["Some" as "Some", m];
  coco = ["None" as "None"] as foobar;
  return coco;
}

const f = (m : foobar) : int => {
  if (Option.is_none(m)) {
    return Option.value(1, m);
  } else {
    if (Option.is_some(m)) {
      return Option.value_with_error("won't happen", m);
    } else {
      return -1;
    }
  }
}

const j = f(s);
const k = f(n);
