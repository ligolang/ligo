/* Simple test of binding multiple values */

const [x, y] : [int, int] = [1,2];

const check = (_ : unit) : int => x + y;

const [x2, y2] : [int, int] = [3,3];

const check_paren = (_ : unit) : int => x2 + y2;

const foobar : [int, int] = [23, 42];

const [foo, bar] : [int, int] = foobar;

const non_tuple_rhs = (_ : unit) : int => foo + bar;
