const t1_ = (x : { a : int , b : string }) : int => {
  const { a , b } = x ;
  return a
};
const t1 = t1_  ({a :1 , b : "two"})

const t2_ = (x : [ int , string ]) : int => {
  const [a,b] = x ;
  return a
};
const t2 = t2_ ([ 1 , "two"])


const t3_ = (x : [ int , [int , nat] ]) : nat => {
  const [a,[b,c]] = x ;
  return c
};
const t3 = t3_ ([1,[2,3]])
