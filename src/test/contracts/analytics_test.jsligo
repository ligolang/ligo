type storage = int
type return_ = [list<operation>, storage]

type parameter = ["Increment", int] | ["Decrement", int] | ["Reset"]

class C {
  @entry
  increment = (store: storage, delta: int) : return_ => [[], store + delta]

  @entry
  decrement = (store: storage, delta: int) : return_ => [[], store - delta]
}

/* Tests for main access point */

const get_storage = Test.Typed_address.get_storage

const test_initial_storage =
  (
    () => {
      let initial_storage = 42;
      let orig = Test.Originate.contract
        (contract_of(C), initial_storage, 0 as tez);
      return Assert.assert(get_storage(orig.taddr) == initial_storage)
    }
  )();

const test_increment =
  (
    () => {
      let initial_storage = 42;
      let orig = Test.Originate.contract
        (contract_of(C), initial_storage, 0 as tez);
      let contr = Test.Typed_address.to_contract(orig.taddr);
      Test.Contract.transfer_exn
        (contr, ["Increment" as "Increment", 1], 1 as mutez);
      return Assert.assert(get_storage(orig.taddr) == initial_storage + 1)
    }
  )();
