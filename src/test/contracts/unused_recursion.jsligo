type t = {
  foo: int,
  bar: int
}

function coucou (storage: t) : t {
  const number = 2
  const id = (x: int) : int => x;
  /* parameter shadows fun_name: simple */

  function toto (toto: int) : int {
    const number = toto
    return number + 1
  }
  /* parameter shadows fun_name: complex */

  function foo (foo: ((p: int) => int)) : int {
    const foox = foo(0)
    return foox
  }
  /* fun_name shadowed in body */

  function bar (x: int): t {
    const bar = x
    return { ...storage, bar: bar }
  }

  const n = toto(number) + foo(id)
  return bar(n)
}

// @entry
const main = (_: unit, storage: t): [list<operation>, t] => [[], coucou(storage)]
