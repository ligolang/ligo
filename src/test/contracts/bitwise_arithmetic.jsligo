/* Test JsLIGO bitwise operators */

const or_op  = (n : nat) : nat => Bitwise.or (n, 4 as nat)
const and_op = (n : nat) : nat => Bitwise.and (n, 7 as nat)
const xor_op = (n : nat) : nat => Bitwise.xor (n, 7 as nat)
const lsl_op = (n : nat) : nat => Bitwise.shift_left (n, 7 as nat)
const lsr_op = (n : nat) : nat => Bitwise.shift_right (n, 7 as nat)
