type storage = int

type parameter =
| ["Increment", int]
| ["Decrement", int]

const add = (a: int, b: int) : int => a + b
const sub = (a: int, b: int) : int => a - b;

function main (p: parameter, storage: storage) : [list<operation>, int] {
  let storage2 =
    $match(p, {
      "Increment": (n) => add(storage, n),
      "Decrement": (n) => sub(storage, n)
    });
  return [[], storage2];
}
