export type storage = {
  storage: unit;
  dynamic_entrypoints: dynamic_entrypoints
};

type return_ = [list<operation>, storage];

// @dyn_entry
const poke = (_: unit, store: storage): return_ => {
  const _a = Tezos.get_balance();
  return [[], store];
};

// @entry
const bar = (_: unit, store: storage): return_ => {
  const _a = Tezos.get_balance();
  return [[], store];
};
