type foobar = { foo : int, bar : int };

const fb : foobar = { foo : 0, bar : 0 };

type abc = { a : int, b : int, c : int };

const abc : abc = { a : 42, b : 142, c : 242 };

const a : int = abc.a;
const b : int = abc.b;
const c : int = abc.c;

const projection = (r: foobar) : int => r.foo + r.bar;

const modify = (r: foobar) : foobar => ({foo: 256, bar: r.bar});

const modify_abc = (r: abc) : abc => ({...r, b: 2048, c: 42});

type big_record = { a : int, b : int, c : int, d : int, e : int };

const br : big_record = { a : 23, b : 23, c : 23, d : 23, e : 23 };

type double_record = { inner : abc };

const modify_inner =
  (r: double_record) : double_record => ({...r, inner: {...r.inner, b: 2048}});

const record_int_addition = abc.a + 5;

type other = { other_a: string }

const other : other = { other_a: "3" }

const record_string_addition = other.other_a + "5";
