const _ = Test.Next.IO.set_test_print ();

function f () {
  Test.Next.IO.log("Once");
  return [1 as nat, 1, "Hello"]
}
const [a, b, c] = f ()

const [a1, b1, c1] = [1 as nat, 1, "Hello"]

function _test () {
  Assert.assert (a == a1);
  Assert.assert (b == b1);
  Assert.assert (c == c1)
}

const test = _test()
