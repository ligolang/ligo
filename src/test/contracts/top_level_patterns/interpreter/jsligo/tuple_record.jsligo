const _ = Test.IO.set_test_print ();

type r = { a: nat, b: int, c: string }

function f () {
  const _ = Test.IO.log("Once");
  return [ { a: 1 as nat, b: 1, c: "H" },
           { a: 2 as nat, b: 2, c: "E" },
           { a: 3 as nat, b: 3, c: "L" }
         ]
}

const [ { a: a1, b: b1, c: c1 },
        { a: a2, b: b2, c: c2 },
        { a: a3, b: b3, c: c3 }
      ] = f()

const [ { a: a4, b: b4, c: c4 },
        { a: a5, b: b5, c: c5 },
        { a: a6, b: b6, c: c6 }
    ]
  = [ { a: 1 as nat, b: 1, c: "H" },
      { a: 2 as nat, b: 2, c: "E" },
      { a: 3 as nat, b: 3, c: "L" }
    ]

const test = (() => {
  Assert.assert (a1 + a2 + a3 == a4 + a5 + a6);
  Assert.assert (b1 + b2 + b3 == b4 + b5 + b6);
  Assert.assert (c1 + c2 + c3 == c4 + c5 + c6)
})()
