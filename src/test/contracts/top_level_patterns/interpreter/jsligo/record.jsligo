const _ = Test.IO.set_test_print ();

type r = { a: nat, b: int, c: string }

function f () {
  Test.IO.log("Once");
  return { a: 1 as nat, b: 1, c: "Hello" }
}

const {a, b, c } = f ()

const { a: a1, b: b1, c: c1 } = { a: 1 as nat, b: 1, c: "Hello" }

const test = (() => {
  Assert.assert(a == a1);
  Assert.assert(b == b1);
  Assert.assert(c == c1)
})()
