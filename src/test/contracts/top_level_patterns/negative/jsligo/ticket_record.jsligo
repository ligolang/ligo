type t = { b: ticket<string> };

const { b } = {
  b: Option.value_with_error("option is None",
                             Tezos.Ticket.create("one", 10 as nat))
};

type storage = ticket<string>;

// @entry
const main = (_p: unit, _s: storage): [list<operation>, storage] =>
      [[], Option.value_with_error("option is None",
                                   Tezos.Ticket.join([b, b]))];
