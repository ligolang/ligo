namespace C {
  export type storage = unit
  type result = [list<operation>, storage];

  export class C {
    @entry foo = (_u : unit, s : storage) : result => [[], s];
    @view bar = (_u : unit, s : storage) => s;
  }
}

const test = (() => {
  let orig = Test.Next.Originate.contract(contract_of(C.C), [], 0 as tez);
  Test.Next.IO.log(orig.code);
  let c = Test.Next.Typed_address.to_contract(orig.taddr);

  Test.Next.IO.log(Tezos.call_view("bar", unit,
                                   Tezos.address(c)) as option<C.storage>);
})();
