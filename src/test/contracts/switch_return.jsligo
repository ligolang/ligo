type parameter =
  { kind: "Increment", amount: int }
| { kind: "Decrement", amount: int }
| { kind: "Reset" };

function check (action: parameter) {
  switch (action.kind) {
    case "Increment":
      const a = action.amount;
      const b = 3;
      return a + b * 3;
    case "Decrement":
      if (action.amount > 4) return 2; else return 5;
    case "Reset": {
      const amount = 0;
      const amount2 = amount + 3;
      const amount3 = amount2 - 2;
      const amount4 = amount3 * 3;
      return amount4
    }
  }
};

const _INCREMENT = 0;
const _DECREMENT = 1;
const _RESET = 2;

function check2 (action: int) {
  switch (action) {
    case _INCREMENT:
      const a = 2;
      const b = 3;
      return a + b * 3;
    case _DECREMENT:
      if (action > 4) return 2; else return 5;
    case _RESET: {
      const amount = 0;
      const amount2 = amount + 3;
      const amount3 = amount2 - 2;
      const amount4 = amount3 * 3;
      return amount4
    }
    default:
      return -1;
  }
}
