import Tezos = Tezos.Next;

class C {
  @entry
  main = (_u : unit, _b : address) : [list <operation>, address] => {
    const c : contract<int> =
      Option.value_with_error("option is None",
                              Tezos.get_entrypoint_opt ("%foo", Tezos.get_sender()));
    return [[], Tezos.address(c)];
  }
};
