type storage = [int, int];

const main = (n0: int, n1: storage) : [list<operation>, storage] => {
  const x: int = 7;
  const x2: [int, int] = [x + n0, n1[0] + n1[1]];
  return [[], x2];
};

const f0 = (_a: string) : bool => true
const f1 = (_a: string) : bool => true
const f2 = (_a: string) : bool => true

const letin_nesting = (_unit: unit) : string => {
  const s = "test";
  const p0 = f0(s);
  Assert.assert(p0);
  const p1 = f1(s);
  Assert.assert(p1);
  const p2 = f2(s);
  Assert.assert(p2);
  return s
}

const letin_nesting2 = (x: int) : int => {
  const y = 2;
  const z = 3;
  return x + y + z
}

function f (_x: int) : nat {
 const [_ig1, [x, _ig2]] = [1 as nat, [2 as nat, 3 as nat]];
 return x;
}
