type myt =
  | ["Nil"]
  | ["Cons", [int, int]];

// this essentially test variable substitution (see var rule)
const t2 = (x: myt, y: myt): int =>
  $match(x, {
    "Nil": () =>
      $match(y, {
        "Nil": () => 1,
        "Cons": ([_a, b]) =>
          (() => {
            const a1 = "a";
            return (int(String.length(a1))) + b})()
      }),
    "Cons": (p) =>
      (() => {
        let [a, b]: [int, int] = p;
        const old_b = b;
        const b_fn = (a: int, b: int): int =>
          $match(y, {
            "Nil": () => (() => {
              let f = (b: int): int => b + a;
              return f(b + 1)})(),
            "Cons": (_) => a + b
          });
        b = b_fn(a, b);
        return a + b + old_b})()
  })
