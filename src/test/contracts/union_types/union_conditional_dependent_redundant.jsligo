type t = { typ: "INT", val: int } | { typ: "STR", val: string }

function f = (x: int) {
  const record: t = { typ: "INT" as "INT", val: x };

  if (record.typ == "INT")
    if (record.typ == "INT")
      return record.val + 1;
    else
      return -1;
  else
    if (record.typ == "INT")
      return -2;
    else
      return int(String.length(record.val));
}

class C {
  @entry
  entry = (_p: unit, s: int): [list<operation>, int] => [[], f(s)];
}
