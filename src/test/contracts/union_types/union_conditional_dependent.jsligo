function f (x: int) {
  const record: { typ: "INT", val: int } | { typ: "STR", val: string } = {
    typ: "INT" as "INT",
    val: x
  };
  if (record.typ == "INT")
    return record.val + record.val;
  else
    return int(String.length(record.val));
}

class C {
  @entry
  entry = (_p: unit, s: int) : [list<operation>, int] => [[], f(s)];
}
