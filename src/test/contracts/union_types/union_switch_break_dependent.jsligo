function f (x: int) {
  const record: { typ: "INT", val: int } | { typ: "STR", val: string } = {
    typ: "INT" as "INT",
    val: x
  };
  let result = -100;
  switch (record.typ) {
    case "INT":
      result = record.val + record.val;
      break;
    case "STR":
      result = int(String.length(record.val));
      break;
  }
  return result;
}

class C {
  @entry
  entry = (_p: unit, s: int): [list<operation>, int] => [[], f(s)];
}
