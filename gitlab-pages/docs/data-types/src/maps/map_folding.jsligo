const my_map: map<string, nat> = Map.literal([
  ["Alice", 1 as nat],
  ["Bob", 4 as nat],
  ["Charlie", 5 as nat],
]);

const fold_function = ([acc, element]: [nat, [string, nat]]): nat => {
  const [_key, value] = element;
  return acc + value;
}

const map_sum: nat = Map.fold(fold_function, my_map, 0 as nat); // 10 as nat