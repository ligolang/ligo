const my_map: map<int,string> =
  Map.literal([[1, "one"], [2, "two"]]);
const contains_2: bool = Map.mem(2, my_map); // == true
const value_option: option<string> = Map.find_opt(2, my_map);
const value = (key, map) =>
  $match(Map.find_opt(key, map), {
    "Some": (value) => value,
    "None": () => failwith("No value."),
  });