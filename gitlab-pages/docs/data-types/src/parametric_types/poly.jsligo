function rev <T>(xs : list<T>) : list<T> {
  const rev = <T>([xs, acc] : [list<T>, list<T>]) : list<T> =>
    $match(List.head_and_tail(xs), {
      "None": () => acc,
      "Some": ([y,ys]) => rev([ys, [y,...acc]])
    });

  return rev([xs, []]);
};
const lint : list<int> = rev([1, 2, 3]);
const lnat : list<nat> = rev([(1 as nat), (2 as nat), (3 as nat)]);