namespace Euro {
  export type t = nat;

  export let add = (a: t, b: t): t => a + b;

  export namespace Coin {
    export let one: t = 1 as nat;
    export let two: t = 2 as nat;
  };
};
type euro_balance = Euro.t;

const increment = (s: euro_balance): euro_balance =>
  Euro.add(s, Euro.Coin.one);