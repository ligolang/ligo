namespace EURO {
  export type t = nat;

  export let add = (a: t, b: t): t => a + b;

  export namespace CONST {
    export let zero: t = 0 as nat;
    export let one: t = 1 as nat;
  };
};
type storage = EURO.t;

// @entry
const main = (_action: unit, store: storage) : [list<operation>, storage] =>
 [[], EURO.add (store, EURO.CONST.one)]