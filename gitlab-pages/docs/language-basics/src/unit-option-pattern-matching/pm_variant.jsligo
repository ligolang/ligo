type color =
| ["RGB", [int, int, int]]
| ["Gray", int]
| ["Default"];

const int_of_color = (c : color) : int =>
  $match(c, {
    "RGB": rgb => 16 + rgb[2] + rgb[1] * 6 + rgb[0] * 36,
    "Gray": i => 232 + i,
    "Default": () => 0
  });
function match_with_block () {
  const x = 1;
  return $match(["Some" as "Some", 1], {
    "None": () => failwith(1),
    "Some": org => (() => { const y = x + 1; return y })()
  })
};