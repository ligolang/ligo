type foo =
  { kind: "increment", amount: int}
| { kind: "decrement", amount: int}
| { kind: "reset"};
const obj = { kind: "increment", amount: 3};
const obj2 = { kind: "reset" };
function foo (item: foo) {
  let state = 0;
  switch(item.kind) {
    case "increment":
      state += item.amount;
      break
    case "decrement":
      state -= item.amount;
      break
    case "reset":
      state = 0;
      break
  }
}