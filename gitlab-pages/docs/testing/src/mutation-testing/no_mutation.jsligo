// This is mutation-contract.mligo
type storage = int;

type result = [list<operation>, storage];

// @entry
const add = (delta : int, store : storage) : result => {
  // @no_mutation
  let _a = Assert.assert (0 == 0);
  return [[], store + delta];
};

// @entry
// @no_mutation
const sub = (delta : int, store : storage) : result =>
  [[], store - delta];