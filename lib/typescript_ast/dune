;; Library exporting the TypeScript AST

(library
 (name typescript_ast)
 (public_name ligo.typescript_ast)
 (modules ast)
 (libraries
  simple_utils
  cst_shared ;; For printing the TS CST
  hex
  zarith
  core
  core_kernel.nonempty_list))

;; Decoder

(executable
 (name decoder_main)
 (libraries core tree_sitter tree_sitter_typescript cst_shared)
 (modules decoder decoder_main))

